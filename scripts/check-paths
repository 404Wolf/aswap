#!/usr/bin/env python3
"""Refuse credential/state filenames and build artifacts, even if force-added."""
import pathlib
import subprocess
import sys

paths = subprocess.check_output(["git", "ls-files", "-z"]).split(b"\0")
for raw in paths:
    if not raw:
        continue
    path = pathlib.PurePosixPath(raw.decode("utf-8", errors="surrogateescape"))
    if (path.name in {"auth.json", "state.json", "usage-cache.json"}
        or path.name.startswith((".credentials", ".env"))
        or path.suffix in {".token", ".key", ".pem", ".p12"}
        or any(part in {"accounts", "target", ".direnv"} for part in path.parts)):
        sys.exit("Refusing credential/state or build-artifact paths in the index (names redacted).")
